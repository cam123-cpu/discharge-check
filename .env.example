# Copy to .env and fill in. Never commit .env.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_PEPPER=
# Optional. Without it the app uses the built-in rule engine only.
ANTHROPIC_API_KEY=
# Set to 1 in any deployed environment (redirects HTTP to HTTPS, sets HSTS, Secure cookies).
# Behind a TLS-terminating proxy, run uvicorn with --proxy-headers --forwarded-allow-ips=<proxy IP>.
FORCE_HTTPS=0
# Required when FORCE_HTTPS=1: the host names the app answers to, comma-separated.
# Requests for any other Host header are refused.
ALLOWED_HOSTS=
DATABASE_PATH=data/app.db
# Optional. Roles that must set up two-factor sign-in, comma-separated, e.g. physician,nurse,admin
MFA_REQUIRED_ROLES=
# The address people use to reach the app. Hospital SSO sends users back to {PUBLIC_BASE_URL}/sso/callback.
PUBLIC_BASE_URL=http://localhost:8000
