# Copy to .env and fill in. Never commit .env.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_PEPPER=
# Optional. Without it the app uses the built-in rule engine only.
ANTHROPIC_API_KEY=
# Set to 1 in any deployed environment (requires HTTPS, sets HSTS, Secure cookies).
FORCE_HTTPS=0
# Hostname browsers should be sent to when FORCE_HTTPS=1. Never taken from the Host header.
# Example: PUBLIC_HOST=charts.hospital.example
PUBLIC_HOST=
# Set to 1 only behind a proxy you control, so X-Forwarded-Proto: https is honored.
# Requires PUBLIC_HOST. The header is trusted only from 127.0.0.1, ::1, and
# TRUSTED_PROXY_IPS. The app does not trust X-Forwarded-For.
TRUST_PROXY=0
# Comma-separated proxy addresses, in addition to loopback. Example: 10.0.0.8
TRUSTED_PROXY_IPS=
DATABASE_PATH=data/app.db
