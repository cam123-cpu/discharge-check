# Copy to .env and fill in. Never commit .env.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_PEPPER=
# Optional. Without it the app uses the built-in rule engine only.
ANTHROPIC_API_KEY=
# Set to 1 in any deployed environment (redirects HTTP to HTTPS, sets HSTS, Secure cookies).
# Behind a TLS-terminating proxy, run uvicorn with --proxy-headers --forwarded-allow-ips=<proxy IP>.
FORCE_HTTPS=0
# Required when FORCE_HTTPS=1: the host names the app answers to, comma-separated.
# Requests for any other Host header are refused.
ALLOWED_HOSTS=
# Database. Leave DATABASE_URL empty to use the SQLite file at DATABASE_PATH
# (the local default, needs nothing installed). Set it to use Postgres, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
DATABASE_PATH=data/app.db
# Optional, Postgres only: connection pool size and extra connections under load.
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=30
# DATABASE_CONNECT_TIMEOUT=10
# Set to 1 when DATABASE_URL is a transaction-mode pooler (PgBouncer, "pooler" URLs).
# DATABASE_PGBOUNCER=0
