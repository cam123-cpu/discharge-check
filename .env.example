# Copy to .env and fill in. Never commit .env.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_PEPPER=
# Optional. Without it the app uses the built-in rule engine only.
ANTHROPIC_API_KEY=
# Set to 1 in any deployed environment (redirects HTTP to HTTPS, sets HSTS, Secure cookies).
# Behind a TLS-terminating proxy, run uvicorn with --proxy-headers --forwarded-allow-ips=<proxy IP>.
FORCE_HTTPS=0
# Required when FORCE_HTTPS=1: the host names the app answers to, comma-separated.
# Requests for any other Host header are refused.
ALLOWED_HOSTS=
DATABASE_PATH=data/app.db

# ---- EHR connection (SMART on FHIR R4). Optional; used by `python -m scripts.fhir_pull`. ----
# Synthetic sandboxes only until a BAA is in place. Never commit real credentials.
# Open sandbox, no login:          FHIR_BASE_URL=https://r4.smarthealthit.org  FHIR_AUTH_MODE=open
# Epic sandbox, backend services:  FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4  FHIR_AUTH_MODE=backend
FHIR_BASE_URL=
# open | backend | standalone
FHIR_AUTH_MODE=open
FHIR_CLIENT_ID=
# Only for a confidential standalone-launch client.
FHIR_CLIENT_SECRET=
# Backend services: path to the PEM private key (keep it outside the repo), its key id, and RS384 or ES384.
FHIR_PRIVATE_KEY_PATH=
FHIR_KEY_ID=
FHIR_JWT_ALG=RS384
# Leave blank for sensible defaults per mode.
FHIR_SCOPES=
# Standalone launch: must be registered with the EHR, e.g. http://localhost:8765/callback
FHIR_REDIRECT_URI=
FHIR_TIMEOUT_SECONDS=20
